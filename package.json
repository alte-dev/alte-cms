{
  "name": "alte-cms-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Modular E-Commerce and CMS Monorepo (Medusa v2 + Next.js 15 + Payload 3)",
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "start": "pnpm --parallel --filter \"./apps/*\" start",
    "lint": "pnpm --recursive lint && eslint scripts",
    "lint:fix": "pnpm --recursive lint --fix && eslint scripts --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml}\"",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "measure:memory": "tsx scripts/measure-memory.ts",
    "setup:store": "pnpm --filter @alte/medusa setup:store",
    "seed:promotions": "pnpm --filter @alte/medusa seed:promotions",
    "verify:store": "tsx scripts/verify-store.ts",
    "verify:storefront": "tsx scripts/verify-storefront.ts",
    "verify:checkout": "tsx scripts/verify-checkout.ts",
    "verify:payments": "tsx scripts/verify-payments.ts",
    "verify:content": "tsx scripts/verify-content.ts",
    "verify:search": "tsx scripts/verify-search.ts",
    "verify:notifications": "tsx scripts/verify-notifications.ts",
    "verify:order-ops": "tsx scripts/verify-order-ops.ts",
    "measure:quality": "tsx scripts/measure-quality.ts",
    "verify:quality": "tsx scripts/verify-quality.ts",
    "verify:production-guard": "tsx scripts/verify-production-guard.ts",
    "verify:all": "tsx scripts/verify-all.ts",
    "check:baseline": "tsx scripts/check-quality-baseline.ts",
    "check:verify-scripts": "tsx scripts/check-verify-scripts.ts",
    "seed:content": "pnpm --filter @alte/web seed:content",
    "seed:fake": "tsx scripts/seed-fake-catalog.ts",
    "create-admin": "pnpm --filter @alte/web create-admin",
    "migrate": "pnpm --filter @alte/medusa db:migrate && pnpm --filter @alte/web migrate",
    "migrate:medusa": "pnpm --filter @alte/medusa db:migrate",
    "migrate:payload": "pnpm --filter @alte/web migrate",
    "migrate:payload:status": "pnpm --filter @alte/web migrate:status",
    "prepare": "lefthook install"
  },
  "pnpm": {
    "overrides": {
      "next": "15.5.29",
      "dompurify": "3.4.17",
      "happy-dom": "21.0.4",
      "postcss": "8.5.32",
      "sharp": "0.35.5",
      "zod": "4.6.7",
      "@types/react": "19.0.10",
      "@types/react-dom": "19.0.4",
      "esbuild": "0.25.0",
      "vitest": "3.2.7",
      "tinypool": "2.2.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.10.7",
    "@types/smtp-server": "3.5.10",
    "eslint": "9.21.0",
    "lefthook": "1.10.10",
    "lighthouse": "13.5.0",
    "playwright": "1.64.1",
    "prettier": "3.5.3",
    "smtp-server": "3.13.6",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.1",
    "zod": "3.24.2"
  }
}

{
  "name": "@alte/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Storefront (Next.js 15) and Payload CMS 3 Admin",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "create-admin": "tsx src/scripts/create-first-admin.ts",
    "seed:content": "tsx src/scripts/seed-content.ts",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status"
  },
  "dependencies": {
    "@alte/shared": "workspace:*",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@puckeditor/core": "0.24.0",
    "dotenv": "18.0.10",
    "graphql": "17.1.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

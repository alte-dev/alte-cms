# ==========================================
# Web Storefront & Payload CMS Environment Variables
# All required fields must be set in .env
# Never commit real credentials to git!
# ==========================================

# Server URL & Database for Payload CMS
NEXT_PUBLIC_SERVER_URL=
DATABASE_URI=
PAYLOAD_SECRET=

# Medusa Communication URLs
# Browser-side access (resolves CORS & cookies)
NEXT_PUBLIC_MEDUSA_URL=
# Server-side access (SSR / Route Handlers)
MEDUSA_BACKEND_URL=
MEDUSA_PUBLISHABLE_KEY=
INTERNAL_API_SECRET=

# Media Storage Configuration
PAYLOAD_MEDIA_DIR=

# Production & Proxy Settings
TRUST_PROXY=
NEXT_OUTPUT_STANDALONE=

# Development Payment Bypass (Strictly dev only; fails closed in production)
ALLOW_DEV_PAYMENT=

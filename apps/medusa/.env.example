# ==========================================
# Medusa v2 Environment Variables Template
# All fields must be provided in .env
# Never commit real credentials to git!
# ==========================================

# Database & Redis Connection
DATABASE_URL=
REDIS_URL=

# Security & Secrets (Must be at least 32 characters, no weak defaults)
JWT_SECRET=
COOKIE_SECRET=

# CORS Configuration (Comma-separated origins)
STORE_CORS=
ADMIN_CORS=
AUTH_CORS=

# Server Configuration
PORT=
HOST=
MEDUSA_WORKER_MODE=
MEDUSA_ADMIN_BACKEND_URL=

# Admin Seed / CLI Credentials (Dev only - leave blank in production templates)
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
MEDUSA_ADMIN_TOKEN=

# Payment Settings & Encryption (Faz 4 - Required 32 bytes hex/base64)
SETTINGS_ENCRYPTION_KEY=
# Internal Web <-> Medusa Secret (Faz 12 - Required >= 32 chars)
INTERNAL_API_SECRET=
API_PUBLIC_URL=
WEB_PUBLIC_URL=

# Dev-only PayTR overrides (Ignored / forbidden in production)
DEV_PAYTR_USER_IP=
PAYTR_API_BASE=

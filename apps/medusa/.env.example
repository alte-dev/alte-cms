# ==========================================
# Medusa v2 Environment Variables Template
# All fields must be provided in .env
# Never commit real credentials to git!
# ==========================================

# Database & Redis Connection
DATABASE_URL=
REDIS_URL=

# Security & Secrets (Must be at least 32 characters, no weak defaults)
JWT_SECRET=
COOKIE_SECRET=

# CORS Configuration (Comma-separated origins)
STORE_CORS=
ADMIN_CORS=
AUTH_CORS=

# Server Configuration
PORT=
HOST=
MEDUSA_WORKER_MODE=
MEDUSA_ADMIN_BACKEND_URL=

{
  "name": "@alte/medusa",
  "version": "0.1.0",
  "private": true,
  "description": "Medusa v2 Commerce Engine",
  "main": "dist/index.js",
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build && node -e \"const fs=require('fs'); if(fs.existsSync('dist/public')) fs.cpSync('dist/public', 'public', {recursive:true, force:true});\"",
    "start": "medusa start",
    "db:migrate": "medusa db:migrate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "setup:store": "medusa exec ./src/scripts/setup-store.ts",
    "seed:promotions": "medusa exec ./src/scripts/seed-promotions.ts",
    "clean": "rimraf .medusa dist"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.4",
    "@medusajs/dashboard": "2.22.4",
    "@medusajs/framework": "2.22.4",
    "@medusajs/icons": "2.22.4",
    "@medusajs/medusa": "2.22.4",
    "@medusajs/ui": "4.2.11",
    "dotenv": "18.0.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.24.2",
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "@medusajs/cli": "2.22.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/nodemailer": "8.0.2",
    "rimraf": "6.1.4",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

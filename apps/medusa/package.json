{
  "name": "@alte/medusa",
  "version": "0.1.0",
  "private": true,
  "description": "Medusa v2 Commerce Engine",
  "main": "dist/index.js",
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build && node -e \"const fs=require('fs'); if(fs.existsSync('dist/public/admin')) { fs.rmSync('public/admin', {recursive:true, force:true}); fs.cpSync('dist/public/admin', 'public/admin', {recursive:true}); }\"",
    "start": "medusa start",
    "db:migrate": "medusa db:migrate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "setup:store": "medusa exec ./src/scripts/setup-store.ts",
    "seed:promotions": "medusa exec ./src/scripts/seed-promotions.ts",
    "clean": "rimraf .medusa dist"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.4",
    "@medusajs/dashboard": "2.22.4",
    "@medusajs/framework": "2.22.4",
    "@medusajs/icons": "2.22.4",
    "@medusajs/medusa": "2.22.4",
    "@medusajs/ui": "4.2.11",
    "dotenv": "16.4.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.2",
    "nodemailer": "10.2.1"
  },
  "devDependencies": {
    "@medusajs/cli": "2.22.4",
    "@types/node": "22.10.7",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/nodemailer": "8.0.2",
    "rimraf": "6.0.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "vitest": "3.0.7"
  }
}
